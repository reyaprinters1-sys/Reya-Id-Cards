        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="18"
                android:endX="96"
                android:endY="90">
                <item android:offset="0.0" android:color="#FF0F172A" />
                <item android:offset="1.0" android:color="#FF1E1B4B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon gradient border -->
    <path
        android:strokeWidth="2"
        android:strokeColor="#38BDF8"
        android:fillColor="#00000000"
        android:pathData="M26,20 L82,20 A10,10 0 0 1 92,30 L92,78 A10,10 0 0 1 82,88 L26,88 A10,10 0 0 1 16,78 L16,30 A10,10 0 0 1 26,20 Z" />

