            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="30"
                android:endX="74"
                android:endY="78">
                <item android:offset="0.0" android:color="#FFF43F5E" />
                <item android:offset="0.4" android:color="#FF8B5CF6" />
                <item android:offset="0.8" android:color="#FF06B6D4" />
                <item android:offset="1.0" android:color="#FFF59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner hollow of R -->
    <path
        android:fillColor="#FF0F172A"
        android:pathData="M46,37 L57,37 C61,37 65,39.5 65,44 C65,48.5 61,51 57,51 L46,51 Z" />

    <!-- Circuit pin nodes -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M76,40 L82,40 L82,42 L76,42 Z" />
    <path
        android:fillColor="#FBBF24"
        android:pathData="M76,46 L82,46 L82,48 L76,48 Z" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M84,41 A1.5,1.5 0 1 0 84,41.1 Z" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M84,47 A1.5,1.5 0 1 0 84,47.1 Z" />

    <!-- Circuit trace inside R -->
    <path
        android:strokeWidth="1.5"
        android:strokeColor="#06B6D4"
        android:fillColor="#00000000"
        android:pathData="M49,44 L57,44" />

    <!-- Glowing cyan dot -->
    <path
        android:fillColor="#06B6D4"
        android:pathData="M46,68 A2,2 0 1 0 46,68.1 Z" />
